{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/arrival.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "vr",
      "offer": "always",
      "features": {
        "handTracking": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.05,
      "far": 220,
      "camera": {
        "position": [
          0,
          1.65,
          0
        ],
        "lookAt": [
          0,
          1.65,
          -20
        ]
      }
    },
    "features": {
      "locomotion": {
        "useWorker": true,
        "browserControls": true
      },
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "horizon"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3"
    }
  }
}
